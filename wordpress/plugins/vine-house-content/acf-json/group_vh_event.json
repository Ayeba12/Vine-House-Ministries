{
  "key": "group_vh_event",
  "title": "Event",
  "fields": [
    {
      "key": "field_vh_event_date",
      "label": "Date",
      "name": "event_date",
      "type": "date_picker",
      "required": 1,
      "display_format": "l, j F Y",
      "return_format": "Y-m-d",
      "first_day": 1
    },
    {
      "key": "field_vh_event_start",
      "label": "Start time",
      "name": "start_time",
      "type": "time_picker",
      "required": 1,
      "display_format": "g:i a",
      "return_format": "H:i"
    },
    {
      "key": "field_vh_event_end",
      "label": "End time",
      "name": "end_time",
      "type": "time_picker",
      "display_format": "g:i a",
      "return_format": "H:i"
    },
    {
      "key": "field_vh_event_location",
      "label": "Location",
      "name": "location",
      "type": "text",
      "default_value": "Sanctuary Hall"
    },
    {
      "key": "field_vh_event_room",
      "label": "Room",
      "name": "room",
      "type": "text"
    },
    {
      "key": "field_vh_event_capacity",
      "label": "Capacity",
      "name": "capacity",
      "type": "number",
      "instructions": "Total places. RSVPs are counted against this by the Forms plugin; 0 means unlimited.",
      "default_value": 0,
      "min": 0,
      "step": 1
    },
    {
      "key": "field_vh_event_host",
      "label": "Host",
      "name": "host",
      "type": "text"
    },
    {
      "key": "field_vh_event_highlights",
      "label": "Highlights",
      "name": "highlights",
      "type": "repeater",
      "layout": "row",
      "button_label": "Add highlight",
      "sub_fields": [
        {
          "key": "field_vh_event_highlight_text",
          "label": "Highlight",
          "name": "text",
          "type": "text",
          "required": 1
        }
      ]
    }
  ],
  "location": [
    [
      {
        "param": "post_type",
        "operator": "==",
        "value": "church_event"
      }
    ]
  ],
  "menu_order": 0,
  "position": "normal",
  "style": "default",
  "label_placement": "top",
  "instruction_placement": "label",
  "active": true,
  "show_in_graphql": 1,
  "graphql_field_name": "eventFields",
  "map_graphql_types_from_location_rules": 0,
  "graphql_types": ["ChurchEvent"]
}
