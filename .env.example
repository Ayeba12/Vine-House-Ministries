# WordPress GraphQL endpoint. LocalWP in development, Bluehost in production.
WORDPRESS_GRAPHQL_ENDPOINT="http://vine-house-ministries.local/graphql"

# WordPress site root. Used for media URLs and links into wp-admin.
NEXT_PUBLIC_WORDPRESS_URL="http://vine-house-ministries.local"

# Application password for the vine-house-forms plugin endpoints.
# Server-side only: these must never be prefixed NEXT_PUBLIC_.
WORDPRESS_APP_USER="vine-forms"
WORDPRESS_APP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"

# Shared secret for the /api/revalidate webhook WordPress calls on publish.
REVALIDATE_SECRET="change-me"
